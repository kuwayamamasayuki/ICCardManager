<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>ICCardManager</RootNamespace>
    <AssemblyName>ICCardManager</AssemblyName>

    <!-- 32ビットモード (felicalib.dllがx86のため) -->
    <PlatformTarget>x86</PlatformTarget>

    <!-- バージョン情報 -->
    <Version>2.10.0</Version>
    <FileVersion>2.10.0.0</FileVersion>
    <AssemblyVersion>2.10.0.0</AssemblyVersion>
    <Company>桑山雅行</Company>
    <Product>交通系ICカード管理システム：ピッすい</Product>
    <Description>交通系ICカードの貸出管理システム</Description>

    <!-- アプリケーションアイコン -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>

    <!-- XMLドキュメント生成 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: XMLコメント欠落, CS8632: Nullable注釈警告（Nullable はプロジェクト単位では無効で、#nullable enable を付けたファイルから
         段階的に移行中のため。未移行のファイルに残る ? 注釈が出す。全ファイルの移行後に <Nullable>enable</Nullable> と共に外す。Issue #2163） -->
    <NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>

    <!-- Issue #2162: .NET アナライザー（CA ルール）を有効化する。net48 では SDK 組み込みのアナライザーが既定で無効のため明示する。
         Recommended は「既定で有効なルール」より広い推奨セット。是正しないルールは ICCardManager/.editorconfig で
         ID ごとに重大度を下げ、理由を直前のコメントに書く（BuildWarningSuppressionConventionTests が検査する）。
         アナライザーは下の PackageReference で版を固定する（SDK の更新でルールが黙って増減しないように）。 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- テストプロジェクトからinternalメンバーへのアクセスを許可 -->
    <InternalsVisibleTo>ICCardManager.Tests</InternalsVisibleTo>
    <!-- Issue #2012: 開発者向けツール DebugDataViewer が
         SettingsViewModel.LoadDatabasePathFromConfigFile() を再利用するため。
         同じ読み取りをツール側へ書き写すと、次に設定ファイルの扱いを変えた人が
         片方を取りこぼす（error-messages.md #1744）。メソッドを public へ昇格させると
         本体の公開 API が増え、ツール以外の消費者を招くため internal のままにする。 -->
    <InternalsVisibleTo>DebugDataViewer</InternalsVisibleTo>
  </PropertyGroup>

  <!-- リリースビルド時はPDBファイルを生成しない -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Issue #1487: VirtualCardDialog は DEBUG 専用機能（Issue #640）のため、Release ビルドから物理的に除外する。
       これにより Release dll に型メタデータと XAML リソースが残らなくなる。
       UI ボタン Visibility / OpenVirtualCardCommand / DI 登録の 3 重 #if DEBUG ガードと併用。 -->
  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Compile Remove="Views\Dialogs\VirtualCardDialog.xaml.cs" />
    <Page Remove="Views\Dialogs\VirtualCardDialog.xaml" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ICCardManager.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Issue #2012: 上の <InternalsVisibleTo> プロパティと同じ内容。
         SDK バージョンによってどちらが効くかが変わるため両方に列挙する。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DebugDataViewer</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite (.NET Framework対応版) -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />

    <!-- Excel操作 -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />

    <!-- DI Container (netstandard2.0対応、.NET Framework 4.8で動作) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- Logging (netstandard2.0対応、.NET Framework 4.8で動作) -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <!-- Issue #2165: Microsoft.Extensions.Hosting（未使用）を外した際、それ経由で推移的に入っていた
         実使用パッケージを直接参照へ昇格した。
         Logging.Configuration       : ILoggingBuilder.AddConfiguration（App.xaml.cs / FileLoggerExtensions）
         Options.ConfigurationExtensions : services.Configure<T>(IConfiguration)（App.xaml.cs） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <!-- Memory Cache (netstandard2.0対応、CVE-2024-43485修正済み) -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />

    <!-- MVVM Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- FeliCa Library - Sony PaSoRi 用 -->
    <PackageReference Include="FelicaLib.DotNet" Version="1.2.67" />

    <!-- Issue #2162: .NET アナライザー（ビルド時のみ。配布物には含まれない）。
         版は global.json の SDK（8.0）に揃える。SDK に同梱のアナライザーではなくパッケージで固定するのは、
         SDK の機能帯が上がる（rollForward = latestFeature）だけで同梱のアナライザーの版が変わり得て、開発機と CI で結果が分かれないようにするため。
         版を上げるとルールが増えるので、上げる PR で Release・Debug の警告 0 を実測する。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- .NET Framework アセンブリ参照 -->
    <Reference Include="ReachFramework" />
    <Reference Include="System.Printing" />
    <Reference Include="System.Windows.Forms" />
    <!-- Issue #1691: xlsx（OPC/ZIP）からシート名だけを読み出す XlsxSheetNameReader で使用 -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- リソースファイル -->
    <None Update="Resources\Sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Templates\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 設定ファイル -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- FeliCa ネイティブライブラリ (Sony PaSoRi用)
         出自: https://github.com/tmurakam/felicalib
         ライセンス: BSD-3-Clause License (Copyright (c) 2007 Takuya Murakami)
         ※正典は ICCardManager/docs/THIRD_PARTY_LICENSES.md（Issue #1822 で MIT 表記の誤りを訂正）
         SHA-256: f49c3af37dadf3d8a309492a2eb7fcded8c66dd3bb1bec855597bd65f9d9460d
         x86ネイティブDLL。NuGetパッケージ管理外のため、ハッシュで整合性を管理 -->
    <None Include="felicalib.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 埋め込みリソース（駅コードマスタ） -->
    <EmbeddedResource Include="Resources\StationCode.csv">
      <LogicalName>ICCardManager.Resources.StationCode.csv</LogicalName>
    </EmbeddedResource>
    <!-- 埋め込みリソース（物品出納簿テンプレート）- フォールバック用 -->
    <EmbeddedResource Include="Resources\Templates\物品出納簿テンプレート（市長事務部局）.xlsx">
      <LogicalName>ICCardManager.Resources.Templates.物品出納簿テンプレート（市長事務部局）.xlsx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Templates\物品出納簿テンプレート（企業会計部局）.xlsx">
      <LogicalName>ICCardManager.Resources.Templates.物品出納簿テンプレート（企業会計部局）.xlsx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
