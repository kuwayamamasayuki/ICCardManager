<Window x:Class="ICCardManager.Views.Dialogs.SystemManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ICCardManager.ViewModels"
        xmlns:common="clr-namespace:ICCardManager.Common"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SystemManageViewModel}"
        Title="システム管理"
        Height="860"
        Width="650"
        MinHeight="700"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.Name="システム管理ダイアログ"
        AutomationProperties.HelpText="操作ログの確認、データベースのバックアップとリストアを行います。Escapeキーで閉じます。">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <common:FileSizeConverter x:Key="FileSizeConverter"/>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- データベース情報（Issue #1686） -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 摘要の設定（Issue #1905） -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- データベース情報（Issue #1686） -->
        <!-- 「このPCがどのDBを見ているか」を設定画面を開かずに確認できる常設表示。
             共有モードのトラブル時、最初の切り分け（どのDBか・到達/書込できるか）をこの画面で完了させる。 -->
        <GroupBox Grid.Row="0" Header="データベース情報" Margin="0,0,0,15" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="{Binding DatabaseModeIcon, Mode=OneWay}"
                               FontSize="{DynamicResource BaseFontSize}"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding DatabaseModeText, Mode=OneWay}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource BaseFontSize}"
                               AutomationProperties.Name="{Binding DatabaseModeText}"/>
                </StackPanel>

                <TextBlock Text="{Binding DatabasePathDisplay, Mode=OneWay, StringFormat=現在のデータベース: {0}}"
                           ToolTip="{Binding DatabasePathDisplay}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,0,0,10"
                           AutomationProperties.Name="{Binding DatabasePathDisplay, StringFormat=現在のデータベース: {0}}"/>

                <!-- Issue #1690: 「接続をテスト」（DBのみ）を接続診断へ統合。
                     DBの到達性・書込権限は診断項目に内包されるため機能は後退しない。 -->
                <Button Content="接続診断"
                        Command="{Binding OpenConnectionDiagnosticsCommand}"
                        Padding="15,10"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="接続診断を開く"
                        AutomationProperties.HelpText="データベース、ICカードリーダー、バックアップ保存先の状態をまとめて確認し、結果をコピーできます。"
                        ToolTip="データベース・ICカードリーダー・バックアップ保存先の状態をまとめて確認します"/>
            </StackPanel>
        </GroupBox>

        <!-- 操作ログ -->
        <GroupBox Grid.Row="1" Header="操作ログ" Margin="0,0,0,15" Padding="15">
            <StackPanel>
                <TextBlock Text="システムの操作履歴を確認できます。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,0,0,10"/>

                <Button Content="操作ログを表示"
                        Command="{Binding OpenOperationLogCommand}"
                        Padding="15,10"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="操作ログを表示"
                        ToolTip="操作履歴の検索・確認を行います"/>
            </StackPanel>
        </GroupBox>

        <!-- バックアップ状況（Issue #1689） -->
        <!-- 起動時の自動バックアップは fire-and-forget のため、失敗しても管理者は気づけなかった。
             最終成功日時・世代数・空き容量をここに常設表示し「静かな失敗」を早期発見できるようにする。
             長文になり得る行はすべて TextWrapping="Wrap"（横 StackPanel を使わない）。Issue #1687 / #1688 参照。 -->
        <GroupBox Grid.Row="2" Header="バックアップ状況" Margin="0,0,0,15" Padding="15">
            <StackPanel>
                <!-- 最終成功日時: 色だけでなくアイコンでも状態を伝える（UI/UX原則） -->
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding BackupHealthIcon, Mode=OneWay}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Top"
                               FontSize="{DynamicResource BaseFontSize}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackupStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding LastBackupSuccessText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontWeight="Bold"
                               FontSize="{DynamicResource BaseFontSize}"
                               AutomationProperties.Name="{Binding LastBackupSuccessText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackupStale}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>

                <TextBlock Text="{Binding BackupGenerationText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           AutomationProperties.Name="{Binding BackupGenerationText}"/>

                <TextBlock Text="{Binding BackupFreeSpaceText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           AutomationProperties.Name="{Binding BackupFreeSpaceText}"/>

                <TextBlock Text="{Binding BackupFolderText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding BackupFolderText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           AutomationProperties.Name="{Binding BackupFolderText}"/>

                <!-- 共有モードでのみ「どのPCが実施したか」を表示（ローカルモードでは自明なため出さない） -->
                <TextBlock Text="{Binding LastBackupMachineText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Visibility="{Binding IsSharedMode, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.Name="{Binding LastBackupMachineText}"/>

                <TextBlock Text="{Binding LastVacuumText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Visibility="{Binding IsSharedMode, Converter={StaticResource BoolToVisibilityConverter}}"
                           AutomationProperties.Name="{Binding LastVacuumText}"/>

                <TextBlock Text="任意のタイミングでデータベースのバックアップを作成できます。"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,10,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="バックアップを作成"
                            Command="{Binding CreateBackupCommand}"
                            Padding="15,10"
                            Background="{DynamicResource SuccessActionBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            AutomationProperties.Name="バックアップを作成"
                            ToolTip="現在のデータベースのバックアップを作成します"/>

                    <Button Content="バックアップフォルダを開く"
                            Command="{Binding OpenBackupFolderCommand}"
                            Padding="15,10"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="バックアップフォルダを開く"
                            ToolTip="バックアップファイルが保存されているフォルダを開きます"/>
                </StackPanel>

                <!-- 最後に作成したバックアップ -->
                <TextBlock Text="{Binding LastBackupFile, StringFormat=作成先: {0}}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding LastBackupFile, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </GroupBox>

        <!-- リストア -->
        <!-- 摘要の設定（Issue #1905） -->
        <!-- 道路を挟んで向かい合うバス停のように、名前は違うが実質同じ場所を登録する。
             登録しないと、そこで折り返した往復が乗継とみなされ目的地が摘要から消える。 -->
        <GroupBox Grid.Row="3" Header="摘要の設定" Margin="0,0,0,15" Padding="15">
            <StackPanel>
                <TextBlock Text="名前は異なるが実質同じ場所である駅・バス停を登録できます。登録すると、行きと帰りで乗降場所の名前が違う移動も往復として摘要にまとまります。"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,0,0,10"/>

                <Button Content="同一とみなす駅・バス停を設定"
                        Command="{Binding OpenTransferStationGroupsCommand}"
                        Padding="15,10"
                        Background="{DynamicResource HeaderBackgroundBrush}"
                        Foreground="{DynamicResource OnPrimaryBrush}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="同一とみなす駅・バス停を設定"
                        ToolTip="名前が異なるが実質同じ場所である駅・バス停をグループとして登録します"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="リストア（データ復元）" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="バックアップファイルを選択してデータを復元します。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,0,0,10"/>

                <!-- バックアップ一覧 -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="4"
                        MinHeight="120">
                    <ListView ItemsSource="{Binding BackupFiles}"
                              SelectedItem="{Binding SelectedBackup}"
                              SelectionMode="Single"
                              AutomationProperties.Name="バックアップファイル一覧">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ファイル名" Width="220"
                                                DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="作成日時" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm:ss}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="サイズ" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                                       HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- リストアボタン -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="選択したバックアップからリストア"
                            Command="{Binding RestoreCommand}"
                            Padding="15,10"
                            Background="{DynamicResource WarningActionBrush}"
                            Foreground="{DynamicResource OnPrimaryBrush}"
                            AutomationProperties.Name="選択したバックアップからリストア"
                            ToolTip="選択したバックアップファイルからデータを復元します"/>

                    <Button Content="ファイルを指定してリストア"
                            Command="{Binding RestoreFromFileCommand}"
                            Padding="15,10"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="ファイルを指定してリストア"
                            ToolTip="任意のバックアップファイルを選択してデータを復元します"/>

                    <Button Content="一覧を更新"
                            Command="{Binding LoadBackupsCommand}"
                            Padding="15,10"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="バックアップ一覧を更新"
                            ToolTip="バックアップファイルの一覧を再読み込みします"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ステータスメッセージ -->
        <Border Grid.Row="5"
                Padding="10"
                Margin="0,15,0,0"
                CornerRadius="5"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="{DynamicResource BaseFontSize}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- 閉じるボタン -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="閉じる"
                    Click="CloseButton_Click"
                    Padding="20,10"
                    MinWidth="100"
                    IsCancel="True"
                    AutomationProperties.Name="ダイアログを閉じる"
                    ToolTip="ダイアログを閉じます (Escape)"/>
        </StackPanel>

        <!-- 処理中オーバーレイ -->
        <Border Grid.RowSpan="7"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                             Value="{Binding ProgressValue}"
                             Maximum="{Binding ProgressMax}"
                             Width="200" Height="20"
                             Foreground="{DynamicResource PrimaryBrush}"/>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource BaseFontSize}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
