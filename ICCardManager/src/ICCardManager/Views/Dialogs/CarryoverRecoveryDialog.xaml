<Window x:Class="ICCardManager.Views.Dialogs.CarryoverRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ICCardManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CarryoverRecoveryViewModel}"
        Title="繰越情報の復旧"
        Height="560"
        Width="760"
        MinHeight="380"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.Name="繰越情報の復旧ダイアログ"
        AutomationProperties.HelpText="紙の出納簿から移行したカードの、失われた開始ページ番号と繰越累計を書き戻します。保存には職員証の認証が必要です。">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容はスクロール領域に入れ、ボタン行を外に置く（文字サイズ「特大」でもボタンを押せるように。03_画面設計書 §5.6） -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <!-- ヘッダー -->
                <TextBlock Text="{Binding CardDisplayName}"
                           FontSize="{DynamicResource LargeFontSize}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           AutomationProperties.HelpText="復旧するカード"/>

                <!-- 案内 -->
                <Border Background="{DynamicResource ReturnBackgroundBrush}"
                        Padding="12"
                        Margin="0,10,0,15">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource HintForegroundBrush}">
                        <Run Text="💡 入力欄には、操作ログに残っていた失われた値（失われていない項目は現在の値）を入れています。"/>
                        <Run Text="紙の出納簿と突き合わせて確かめてから保存してください。保存には職員証の認証が必要です。"/>
                    </TextBlock>
                </Border>

                <!-- 入力欄。右の列は折り返す（文字サイズが変わっても幅ではなく折り返しで収める） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 開始ページ番号 -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="開始ページ番号(_P)"
                           Target="{Binding ElementName=StartingPageNumberTextBox}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="StartingPageNumberTextBox"
                             Text="{Binding StartingPageNumberText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140"
                             Padding="8,6"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,10"
                             AutomationProperties.Name="開始ページ番号"
                             AutomationProperties.HelpText="物品出納簿の開始ページ番号。1以上の整数"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="失われた値:"/>
                        <Run Text="{Binding LostStartingPageNumberText, Mode=OneWay}"/>
                        <Run Text="／ 現在:"/>
                        <Run Text="{Binding CurrentStartingPageNumberText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 繰越累計受入 -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="繰越累計受入（円）(_I)"
                           Target="{Binding ElementName=CarryoverIncomeTotalTextBox}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="CarryoverIncomeTotalTextBox"
                             Text="{Binding CarryoverIncomeTotalText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140"
                             Padding="8,6"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,10"
                             AutomationProperties.Name="繰越累計受入（円）"
                             AutomationProperties.HelpText="紙の出納簿時代の受入の累計。0以上の整数（円）"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="失われた値:"/>
                        <Run Text="{Binding LostCarryoverIncomeTotalText, Mode=OneWay}"/>
                        <Run Text="／ 現在:"/>
                        <Run Text="{Binding CurrentCarryoverIncomeTotalText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 繰越累計払出 -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="繰越累計払出（円）(_E)"
                           Target="{Binding ElementName=CarryoverExpenseTotalTextBox}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             x:Name="CarryoverExpenseTotalTextBox"
                             Text="{Binding CarryoverExpenseTotalText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140"
                             Padding="8,6"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,10"
                             AutomationProperties.Name="繰越累計払出（円）"
                             AutomationProperties.HelpText="紙の出納簿時代の払出の累計。0以上の整数（円）"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="失われた値:"/>
                        <Run Text="{Binding LostCarryoverExpenseTotalText, Mode=OneWay}"/>
                        <Run Text="／ 現在:"/>
                        <Run Text="{Binding CurrentCarryoverExpenseTotalText, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 対象年度 -->
                    <Label Grid.Row="3" Grid.Column="0"
                           Content="対象年度（西暦）(_Y)"
                           Target="{Binding ElementName=CarryoverFiscalYearTextBox}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,10"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             x:Name="CarryoverFiscalYearTextBox"
                             Text="{Binding CarryoverFiscalYearText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="140"
                             Padding="8,6"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Margin="0,0,10,10"
                             AutomationProperties.Name="対象年度（西暦）"
                             AutomationProperties.HelpText="繰越累計を加算する年度。西暦4桁（例: 2025）。繰越累計が0円なら空欄でもよい"/>
                    <TextBlock Grid.Row="3" Grid.Column="2"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               FontSize="{DynamicResource SmallFontSize}"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="失われた値:"/>
                        <Run Text="{Binding LostCarryoverFiscalYearText, Mode=OneWay}"/>
                        <Run Text="／ 現在:"/>
                        <Run Text="{Binding CurrentCarryoverFiscalYearText, Mode=OneWay}"/>
                    </TextBlock>
                </Grid>

                <!-- 入力の誤り・競合・認証の案内。複数行になり得るため折り返す -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン（右端が主操作、その左にキャンセル） -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,15,0,0">
            <Button Content="キャンセル"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    AutomationProperties.Name="キャンセル"
                    AutomationProperties.HelpText="保存せずにダイアログを閉じます"
                    ToolTip="保存せずに閉じる (Escape)"/>
            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                    Content="保存(_S)"
                    Command="{Binding SaveCommand}"
                    Padding="20,8"
                    IsDefault="True"
                    AutomationProperties.Name="繰越情報を保存"
                    AutomationProperties.HelpText="入力した繰越情報を保存します。職員証の認証が必要です"
                    ToolTip="職員証の認証のあと保存 (Enter / Alt+S)"/>
        </StackPanel>

        <!-- 処理中オーバーレイ -->
        <Border Grid.RowSpan="2"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" MinHeight="4"/>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource BaseFontSize}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
