<Window x:Class="ICCardManager.Views.Dialogs.SystemLendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ICCardManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SystemLendViewModel}"
        Title="貸出記録の作成"
        Height="480"
        Width="640"
        MinHeight="400"
        MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.Name="貸出記録の作成ダイアログ"
        AutomationProperties.HelpText="ピッすいに読み取らせずに交通系ICカードを持ち出したケースについて、貸出中の記録を作成します。">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 説明（Issue #1909） -->
        <Border Grid.Row="0" Background="{DynamicResource ReturnBackgroundBrush}" CornerRadius="4" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="読み取らずに持ち出された交通系ICカードを、貸出中の状態にします"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ReturnForegroundBrush}"/>
                <TextBlock FontSize="{DynamicResource SmallFontSize}"
                           Foreground="{DynamicResource HintForegroundBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap">
                    <Run Text="💡 残額はカードから読み取れないため、直近の履歴の残額がそのまま引き継がれます。利用内容は、カードが返ってきてメイン画面でタッチされたときに記録されます。"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 入力 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="対象カード:" Margin="0,0,10,10" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding CardDisplayName}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       VerticalAlignment="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Content="借用者(_B):" Margin="0,0,10,10" VerticalAlignment="Center"
                   Target="{Binding ElementName=BorrowerComboBox}"/>
            <ComboBox x:Name="BorrowerComboBox"
                      Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding StaffList}"
                      SelectedItem="{Binding SelectedStaff}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,10"
                      Padding="8,6"
                      FontSize="{DynamicResource BaseFontSize}"
                      AutomationProperties.Name="借用者"
                      AutomationProperties.HelpText="カードを持ち出した職員を選択します"/>

            <Label Grid.Row="2" Grid.Column="0" Content="貸出日時:" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <!-- 横方向 StackPanel は子を無限幅で測定するが、ここに置く子は固定幅の入力欄と
                 短い注記だけで、文字サイズが変わっても折り返しを要しない（#1687） -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <DatePicker SelectedDate="{Binding LentDate}"
                            Width="170"
                            FontSize="{DynamicResource BaseFontSize}"
                            AutomationProperties.Name="貸出日"
                            AutomationProperties.HelpText="カードを持ち出した日を選択します"/>
                <TextBox Text="{Binding LentTimeText, UpdateSourceTrigger=PropertyChanged}"
                         Width="90"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         FontSize="{DynamicResource BaseFontSize}"
                         AutomationProperties.Name="貸出時刻"
                         AutomationProperties.HelpText="24時間制で時と分をコロンで区切って入力します。例: 9:30"
                         ToolTip="24時間制。例: 9:30、17:05"/>
                <TextBlock Text="（24時間制）"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource SmallFontSize}"
                           Foreground="{DynamicResource HintForegroundBrush}"/>
            </StackPanel>
        </Grid>

        <!-- ステータス。成功・失敗のいずれでも表示できる位置に置く（可変の表示条件に紐付けない。#1727） -->
        <TextBlock Grid.Row="2"
                   VerticalAlignment="Top"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource SmallFontSize}"
                   AutomationProperties.Name="{Binding StatusMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,15,0,0">
            <Button Content="キャンセル(_C)"
                    Padding="15,10"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    FontSize="{DynamicResource BaseFontSize}"
                    AutomationProperties.Name="キャンセル"
                    AutomationProperties.HelpText="貸出記録を作成せずに閉じます"
                    ToolTip="作成せずに閉じる (Escape / Alt+C)"/>
            <Button Content="貸出記録を作成(_S)"
                    Command="{Binding SaveCommand}"
                    Padding="20,10"
                    Background="{DynamicResource SuccessActionBrush}"
                    Foreground="{DynamicResource OnPrimaryBrush}"
                    IsDefault="True"
                    FontSize="{DynamicResource BaseFontSize}"
                    AutomationProperties.Name="貸出記録を作成"
                    AutomationProperties.HelpText="指定した借用者と日時で貸出中の記録を作成します"
                    ToolTip="貸出記録を作成 (Enter / Alt+S)"/>
        </StackPanel>

        <!-- 処理中オーバーレイ -->
        <Border Grid.RowSpan="4"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="{Binding BusyMessage}"
                           Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="{DynamicResource BaseFontSize}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
