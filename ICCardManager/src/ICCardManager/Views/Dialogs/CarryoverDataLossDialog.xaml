<Window x:Class="ICCardManager.Views.Dialogs.CarryoverDataLossDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ICCardManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CarryoverDataLossViewModel}"
        Title="繰越情報が失われたカード"
        Height="500"
        Width="1150"
        MinHeight="350"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.Name="繰越情報が失われたカードの一覧ダイアログ"
        AutomationProperties.HelpText="紙の出納簿から移行したカードの繰越累計・開始ページ番号が失われている場合に、失われた元の値を確認し、行ごとの「復旧...」から書き戻せます。">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="繰越情報が失われたカード"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontWeight="Bold"/>
            <!-- 長文は幅ではなく折り返しで担保する（.claude/rules/development-conventions.md UI/UX原則）。
                 親が縦 StackPanel なので幅制約があり TextWrapping が機能する。 -->
            <TextBlock Text="過去のバージョンでカード情報を編集した際に、紙の出納簿から移行したカードの繰越累計・開始ページ番号が消去されました。下の一覧で失われた元の値を確認し、この画面から書き戻せます。"
                       FontSize="{DynamicResource SmallFontSize}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 復旧手順の案内 -->
        <Border Grid.Row="1"
                Background="{DynamicResource ReturnBackgroundBrush}"
                Padding="12"
                Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap"
                       FontSize="{DynamicResource SmallFontSize}"
                       Foreground="{DynamicResource HintForegroundBrush}"
                       Text="💡 復旧するには、カード名の右にある「復旧...」を押してください。失われた値が入った入力欄が開くので、紙の出納簿と突き合わせて確かめてから保存します（職員証の認証が必要です）。復旧したカードは一覧から消え、この画面を閉じるとメイン画面の警告も更新されます。"/>
        </Border>

        <!-- 一覧 -->
        <DataGrid Grid.Row="2"
                  x:Name="CarryoverDataLossDataGrid"
                  ItemsSource="{Binding Items}"
                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  FrozenColumnCount="2"
                  CopyingRowClipboardContent="CarryoverDataLossDataGrid_CopyingRowClipboardContent"
                  HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource NeutralBorderBrush}"
                  BorderThickness="1"
                  FontSize="{DynamicResource BaseFontSize}"
                  AutomationProperties.Name="繰越情報が失われたカードの一覧"
                  AutomationProperties.HelpText="セルを選択して Ctrl+C を押すと、失われた値をコピーできます。">

            <!-- Issue #2258: 列幅はピクセルで固定せず、見出しと値に合わせる（Auto）。固定幅は文字サイズを大きくすると
                 見出し・値が切れ、残りを受け持つ列（以前の「操作者」の *）は幅がほとんど残らなかった。
                 収まらないときは横スクロールにし（値を切らない）、操作に要る「カード」と「復旧」は左に固定して
                 スクロールしても見えるようにする（FrozenColumnCount="2"）。
                 ウィンドウの既定幅 1150 は、Yu Gothic UI で文字サイズ「特大」（20）の見出し・値の幅を FormattedText で
                 実測し（各列の最大の文字幅の合計 922px。「大」（16）は 735px）、列の余白・ボタン・枠・余白を足して
                 横スクロールせずに収まる幅にした。作業領域がこれより狭い PC（1366 幅で表示倍率 125% 等）では、
                 コードビハインドが作業領域の幅で切り詰め、収まらない分は横スクロールになる。 -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="カード"
                                    Binding="{Binding CardDisplayName}"
                                    Width="Auto"/>
                <!-- Issue #2255: 行ごとの復旧。ボタンなので Tab で辿って Enter / スペースでも押せる（#2078） -->
                <!-- コピー（Ctrl+C）では、この列を除く（ボタンだけの列が値の列の間に空の列として出るため。Issue #2258） -->
                <DataGridTemplateColumn x:Name="RecoverColumn"
                                        Header="復旧"
                                        Width="Auto"
                                        CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="復旧..."
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Padding="12,4"
                                    Margin="4,2"
                                    AutomationProperties.Name="{Binding CardDisplayName, StringFormat={}{0} の繰越情報を復旧}"
                                    AutomationProperties.HelpText="失われた値を入れた入力欄を開き、確かめてから書き戻します"
                                    ToolTip="このカードの繰越情報を復旧する"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="開始ページ番号"
                                    Binding="{Binding LostStartingPageNumberText}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="繰越累計受入"
                                    Binding="{Binding LostCarryoverIncomeTotalText}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="繰越累計払出"
                                    Binding="{Binding LostCarryoverExpenseTotalText}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="対象年度"
                                    Binding="{Binding LostCarryoverFiscalYearText}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="消去された日時"
                                    Binding="{Binding LostAtText}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="操作者"
                                    Binding="{Binding OperatorName}"
                                    Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 0件時の案内（警告クリック後に他PCで復旧された場合などに到達する）。
             文言は ViewModel が持つ: 一覧が空になる理由には「被害が無い」と「確認できなかった」の
             2つがあり、後者に「ありません」と出すと被害なしと誤読させるため（Issue #1758）。 -->
        <TextBlock Grid.Row="2"
                   Text="{Binding EmptyStateMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryTextBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- フッター -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock TextWrapping="Wrap"
                           FontSize="{DynamicResource SmallFontSize}"
                           Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding Items.Count, Mode=OneWay, StringFormat={}{0}件}"/>
                </TextBlock>
                <!-- Issue #2255: 復旧の結果。最後の 1 枚を復旧すると一覧が空になるため、
                     一覧の表示条件（HasItems）に紐付かないここへ置く（#1727 の「所在」） -->
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontWeight="Bold"
                           Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="閉じる"
                        Click="CloseButton_Click"
                        Padding="20,8"
                        IsCancel="True"
                        AutomationProperties.Name="ダイアログを閉じる"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
