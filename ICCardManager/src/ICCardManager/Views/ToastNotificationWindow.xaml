<Window x:Class="ICCardManager.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="通知"
        MinWidth="{DynamicResource ToastMinWidth}"
        MaxWidth="{DynamicResource ToastMaxWidth}"
        MaxHeight="{DynamicResource ToastMaxHeight}"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.HelpText="通知ウィンドウ"
        AutomationProperties.LiveSetting="Assertive">
    <!-- Issue #2142: 読み上げソフトへ貸出・返却の結果を伝えるのは、この窓の LiveRegionChanged である
         （#186 によりメイン画面は変わらないので、通知が唯一の結果表示）。UIA は通知した要素の Name を読むため、
         Name は固定のラベルではなく通知の内容を Show() が設定する（AutomationProperties.SetName）。
         固定の「通知ウィンドウ」は HelpText へ移した。LiveSetting を付けただけでは通知は発火しないので、
         Show() が LiveRegionAnnouncer で明示的に発火する（ui-conventions #2073）。 -->

    <Window.Resources>
        <!-- フェードイン・アウトアニメーション -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="ToastBorder"
            CornerRadius="12"
            Margin="10"
            Padding="20,15"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- アイコン -->
            <!-- Issue #2073: 絵文字は読み上げても意味が伝わらず、種別はタイトル文言が併せて伝えるため、
                 ここは固定の Name を保つ（Text の内容を隠していない装飾要素）。
                 DynamicTextAutomationNameConventionTests の装飾アイコン許容リストに登録済み。 -->
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontSize="{DynamicResource IconFontSize}"
                       VerticalAlignment="Center"
                       Margin="0,0,15,0"
                       AutomationProperties.Name="通知アイコン"/>

            <!-- メッセージ -->
            <!-- Issue #1273: タイトルは単一行＋省略（CharacterEllipsis）でトースト高さ暴走を防止。
                 メッセージとサブメッセージは Wrap を維持しつつ Window.MaxHeight 内に収める。 -->
            <!-- Issue #2142: 本文・補足の階層は Opacity ではなく文字色（ApplyStyle）で表す。
                 Opacity は文字を地色へ寄せるので、補足行（Opacity 0.6）は貸出・返却・エラーの 3 種の背景すべてで
                 約 3.1:1 まで落ちていた。この行には残額不足の警告と「クリックまたは Esc キーで閉じる」が入る。 -->
            <!-- Issue #2073: 3つの TextBlock は Show() が Text を差し替えるため、固定の読み上げ名を
                 AutomationProperties.Name ではなく HelpText で持つ。Name に固定文言を置くと
                 TextBlockAutomationPeer の Text フォールバックを上書きし、カード名・残額・エラー内容が
                 スクリーンリーダー経路から丸ごと消える（Issue #1812 と同じ形）。 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="{DynamicResource TitleFontSize}"
                           FontWeight="Bold"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.HelpText="通知タイトル"/>
                <TextBlock x:Name="MessageText"
                           FontSize="{DynamicResource BaseFontSize}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           AutomationProperties.HelpText="通知メッセージ"/>
                <TextBlock x:Name="SubMessageText"
                           FontSize="{DynamicResource SmallFontSize}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.HelpText="追加メッセージ"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
