root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,vb}]
# C# ソースは BOM なしの UTF-8（Issue #2161）。CI の dotnet format が検査する。
# 既存ファイルの多数派（780 中 641）に合わせた。
charset = utf-8

# 名前付け規則
# private の const / static readonly は .NET の慣例どおり PascalCase（Issue #2161）。
# 下の「private フィールドは _camelCase」は修飾子を指定しないため、これらの規則が無いと
# const / static readonly まで _ プレフィックスを要求していた。修飾子を指定した規則のほうが
# 具体的なので優先される。
dotnet_naming_rule.private_constants_should_be_pascal_case.severity = warning
dotnet_naming_rule.private_constants_should_be_pascal_case.symbols = private_constants
dotnet_naming_rule.private_constants_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_fields_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_should_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_camel_case.style = camel_case_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.camel_case_underscore.capitalization = camel_case
dotnet_naming_style.camel_case_underscore.required_prefix = _

# using文の整理
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# varの使用
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# 式形式のメンバー
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# null チェック
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

# パターンマッチング
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# ブレース
csharp_prefer_braces = true:warning

# 新しい行設定
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# ---------------------------------------------------------------------------
# .NET アナライザー（CA ルール）の重大度（Issue #2162）
# 本体（src/ICCardManager）の csproj で AnalysisMode=Recommended を有効にしている。
# 是正しないルールは ID ごとに重大度を下げ、直前のコメントに理由を書く
# （BuildWarningSuppressionConventionTests が、直前のコメントに ID が無い格下げを検出する）。
# ---------------------------------------------------------------------------
[src/ICCardManager/**.cs]
# CA1848（LoggerMessage デリゲートを使う）: 高頻度ログの割り当てを減らす性能ルール。
# 本システムのログは操作単位（貸出・返却・保存）で毎秒何件も出ないため効果が無く、
# 252 か所をデリゲート定義へ書き換えると読みにくさだけが増える。
dotnet_diagnostic.CA1848.severity = none

# CA1716（識別子が他言語の予約語と一致する）: Get / Set / Stop / Error が VB の予約語に当たるという指摘。
# 本体は単一の C# アプリで、他言語から実装・継承されるライブラリではない。
# インターフェースのメンバー名を変えると実装・モック・テストへ波及するだけで、得るものが無い。
dotnet_diagnostic.CA1716.severity = none

# CA1000（ジェネリック型に静的メンバーを宣言しない）: ServiceResult<T>.Ok / Fail、CardReadResult<T> の
# 静的ファクトリが対象。型引数を推論させる生成手段として意図した形で、呼び出し側の可読性が高い。
dotnet_diagnostic.CA1000.severity = none

# CA1859（性能のために具象型を使う）: private メソッドの戻り値・引数をインターフェースから具象型へ変える提案。
# 本システムでの性能差は観測できず、IReadOnlyList 等で「書き換えない」意図を表した宣言や、
# App.CreateCardReader のように ICardReader（抽象）として生成する意図が失われる。
dotnet_diagnostic.CA1859.severity = none

# CA1822（インスタンスデータを参照しないメンバーを static にする）は private に限る。
# public メンバーは XAML のバインディング（ViewModel のプロパティ）や DI で注入したインスタンス越しに、
# internal メンバーはテストからインスタンス越しに呼ばれるため、static にすると呼び出し側の形が変わる
# （インスタンス越しに static メンバーは呼べない）。private は是正する。
dotnet_code_quality.CA1822.api_surface = private

# ConfigureAwait（CA2007）は async-configureawait.md の層別規約に合わせる（Issue #1287 / #2162）。
# まず本体全体で CA2007 を無効にし、下の節で Service 層等だけを warning へ上げる。
# ViewModels / Views / App.xaml.cs は継続を UI スレッドへ戻す必要があり、付けてはならないため。
dotnet_diagnostic.CA2007.severity = none

[src/ICCardManager/{Common,Data,Dtos,Infrastructure,Models,Services}/**.cs]
dotnet_diagnostic.CA2007.severity = warning

[src/ICCardManager/Data/Migrations/Migration_*.cs]
# CA1707（識別子にアンダースコアを含めない）: マイグレーションのクラス名は Migration_0NN_<説明> の命名規約
# （migrations.md「新規マイグレーション追加手順」）で、版の番号を名前で読めるようにしている。
dotnet_diagnostic.CA1707.severity = none

[src/ICCardManager/Services/DialogService.cs]
# CA2007: DialogService は内部で MessageBox 等の UI API を呼ぶため、継続が UI スレッドへ戻る必要がある
# （async-configureawait.md「例外: UI 依存サービス」。ConfigureAwaitConventionTests の除外と同じ）。
dotnet_diagnostic.CA2007.severity = none

[*.{xml,xaml,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
